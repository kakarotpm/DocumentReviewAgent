# Copy this file to .env and fill in your values. Never commit .env.

# Which AI reviews documents: anthropic (Claude) or openai (GPT).
# Without the chosen provider's key, the app runs in demo mode.
AI_PROVIDER=anthropic

# Anthropic (Claude), used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
# How hard the model thinks: low, medium or high
ANTHROPIC_EFFORT=medium

# OpenAI (GPT), used when AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-key-here
# The model name your key can use, exactly as shown on the OpenAI dashboard
OPENAI_MODEL=
# Reasoning models only: low, medium or high. Leave blank if your model doesn't support it.
OPENAI_REASONING_EFFORT=
